# Postgres (Railway addon o local)
DATABASE_URL=postgresql://user:pass@localhost:5432/artiline

# Auth.js
AUTH_SECRET=
AUTH_URL=http://localhost:1355
# AUTH_TRUST_HOST=true   # poner true en prod detrás de un reverse proxy

# Resend (magic links + invitaciones)
RESEND_API_KEY=
RESEND_FROM=noreply@artiline.app

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=artiline-exports
R2_PUBLIC_URL=

# Cron (jobs de fondo: deliver-webhooks, prune-audit)
# CRON_SECRET=          # bearer token que protege /api/cron/* en prod

# Host canónico (custom domains)
# NEXT_PUBLIC_ARTILINE_HOST=app.artiline.app   # si no se setea, cae a AUTH_URL

# Homepage en "/" para visitantes anónimos: marketing | app
# Sin setear: cloud -> marketing, self-host(oss) -> app (entrada simple sin marketing)
# NEXT_PUBLIC_ARTILINE_LANDING=app

# Edition (open-core)
# NEXT_PUBLIC_ARTILINE_EDITION=oss
# LICENSE_KEY=
# LICENSE_DEV_BYPASS=   # local dev only; ignored when NODE_ENV=production
# ARTILINE_ENABLE_CUSTOM_DOMAIN=
