# Postgres (Railway addon o local)
DATABASE_URL=postgresql://user:pass@localhost:5432/artiline

# Auth.js
AUTH_SECRET=
AUTH_URL=http://localhost:1355
# AUTH_TRUST_HOST=true   # poner true en prod detrás de un reverse proxy

# Resend (magic links + invitaciones)
RESEND_API_KEY=
RESEND_FROM=noreply@artiline.app

# Object storage (S3-compatible). Cloudflare R2 by default; set R2_ENDPOINT to
# point at any other backend (e.g. MinIO on Railway).
R2_ACCOUNT_ID=                # only for Cloudflare R2; omit when R2_ENDPOINT is set
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=artiline-exports
R2_PUBLIC_URL=                # public base URL for stored objects (browser-reachable)
# R2_ENDPOINT=                # S3 endpoint for self-hosted MinIO/Garage/etc

# Cron (jobs de fondo: deliver-webhooks, prune-audit)
# CRON_SECRET=          # bearer token que protege /api/cron/* en prod

# Host canónico (custom domains)
# NEXT_PUBLIC_ARTILINE_HOST=app.artiline.app   # si no se setea, cae a AUTH_URL

# Homepage en "/" para visitantes anónimos: marketing | app
# Sin setear: cloud -> marketing, self-host(oss) -> app (entrada simple sin marketing)
# NEXT_PUBLIC_ARTILINE_LANDING=app

# Edition (open-core)
# NEXT_PUBLIC_ARTILINE_EDITION=oss
# LICENSE_KEY=
# LICENSE_DEV_BYPASS=   # local dev only; ignored when NODE_ENV=production
# ARTILINE_ENABLE_CUSTOM_DOMAIN=

# AI edit (core feature — edit an artifact's content via an LLM instruction).
# Set an OpenRouter key and 1-3 model slots to enable it; unset slots are
# skipped. Label defaults to the model id when omitted.
# OPENROUTER_API_KEY=
# ARTILINE_AI_MODEL_1=anthropic/claude-3.5-sonnet
# ARTILINE_AI_MODEL_1_LABEL=Claude 3.5 Sonnet
# ARTILINE_AI_MODEL_2=openai/gpt-4o
# ARTILINE_AI_MODEL_2_LABEL=GPT-4o
# ARTILINE_AI_MODEL_3=google/gemini-pro-1.5
# ARTILINE_AI_MODEL_3_LABEL=Gemini 1.5 Pro
